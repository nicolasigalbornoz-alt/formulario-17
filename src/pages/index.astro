---
// Página principal del sitio: el inicio de sesión. Todo lo demás pide
// usuario; después de ingresar, cada uno va a su página (ver inicioDe).
import "../styles/global.css";
import { inicioDe } from "../lib/auth";

const q = Astro.url.searchParams;
const error = q.get("error");
const volver = q.get("volver") ?? "";
const salida = q.get("salida") === "1";
// Si ya tiene sesión, no tiene sentido volver a pedirla.
if (Astro.locals.usuario) return Astro.redirect(inicioDe(Astro.locals.usuario));
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/png" href="/brand/favicon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="application-name" content="Subsecretaría de Planificación Presupuestaria y Estadística" />
    <title>Subsecretaría de Planificación Presupuestaria y Estadística</title>
  </head>
  <body>
    <main class="login-layout">
      <section class="login-brand-panel">
        <span class="login-logo">
          <img src="/brand/moron-logo.png" alt="Municipio de Morón" width="100" height="110" />
        </span>
        <div>
          <span class="eyebrow light">Subsecretaría de Planificación Presupuestaria y Estadística</span>
          <p>Formulario 17 prellenado para cada secretaría, con los datos de RAFAM.</p>
        </div>
        <span class="login-photo-caption">Municipio de Morón</span>
      </section>
      <section class="login-form-panel">
        <div class="login-form-wrap">
          <span class="eyebrow">Bienvenido / Bienvenida</span>
          <h2>Formulario<br />17.</h2>
          <p class="login-intro">Ingresá con el usuario de tu secretaría para ver el F17 prellenado de tus programas, los instructivos y las fechas de entrega.</p>

          {salida && !error && <div class="alert alert-success">Cerraste la sesión.</div>}
          {error === "invalido" && <div class="alert alert-error">Usuario o contraseña incorrectos.</div>}
          {error === "bloqueado" && <div class="alert alert-error">Demasiados intentos fallidos. Esperá unos minutos y volvé a probar.</div>}
          {error === "config" && <div class="alert alert-warning">Falta configurar el sitio (secrets de sesión en Cloudflare).</div>}

          <form method="post" action="/api/auth/ingresar">
            <input type="hidden" name="volver" value={volver} />
            <label class="form-group">Usuario
              <input class="form-control" name="usuario" required autofocus autocomplete="username" autocapitalize="none" placeholder="Tu usuario" />
            </label>
            <label class="form-group">Contraseña
              <input class="form-control" type="password" name="clave" required autocomplete="current-password" placeholder="Tu contraseña" />
            </label>
            <button class="btn btn-primary login-submit" type="submit">Iniciar sesión <span aria-hidden="true">→</span></button>
          </form>
          <p class="login-note">
            ¿No tenés usuario o te olvidaste la contraseña? Pedíselo a la Subsecretaría: dir.presupuesto@moron.gob.ar · Interno
            7714.
          </p>
        </div>
      </section>
    </main>
  </body>
</html>
