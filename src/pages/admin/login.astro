---
import "../../styles/global.css";
const error = Astro.url.searchParams.get("error");
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/png" href="/brand/favicon.png" />
    <title>Ingresar · Panel · Dirección de Presupuesto</title>
  </head>
  <body>
    <main class="login-layout">
      <section class="login-brand-panel">
        <a href="/" class="login-logo" aria-label="Volver al inicio">
          <img src="/brand/moron-logo.png" alt="Municipio de Morón" width="100" height="110" />
        </a>
        <div>
          <span class="eyebrow light">Dirección de Presupuesto</span>
          <h1>El presupuesto,<br />más cerca.</h1>
          <p>Lista de difusión, avisos y carga de datos de RAFAM.</p>
        </div>
        <span class="login-photo-caption">Municipio de Morón</span>
      </section>
      <section class="login-form-panel">
        <div class="login-form-wrap">
          <span class="eyebrow">Panel administrativo</span>
          <h2>Acceso<br />interno.</h2>
          <p class="login-intro">Ingresá con la contraseña de la Dirección de Presupuesto para administrar el sitio.</p>

          {error === "1" && <div class="alert alert-error">Contraseña incorrecta.</div>}
          {
            error === "config" && (
              <div class="alert alert-warning">
                Faltan configurar los secrets <code>ADMIN_PASSWORD_HASH</code> y <code>SESSION_SECRET</code> en Cloudflare.
              </div>
            )
          }

          <form method="post" action="/api/admin/login">
            <label class="form-group">Contraseña
              <input class="form-control" type="password" name="password" required autofocus autocomplete="current-password" placeholder="Tu contraseña" />
            </label>
            <button class="btn btn-primary login-submit" type="submit">Ingresar <span aria-hidden="true">→</span></button>
          </form>
          <p class="login-note">Solo para el equipo de la Dirección de Presupuesto. Las consultas sobre formularios van a dir.presupuesto@moron.gob.ar.</p>
          <a class="login-site-link" href="/">← Volver al sitio</a>
        </div>
      </section>
    </main>
  </body>
</html>
