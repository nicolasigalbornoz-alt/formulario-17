---
import Base from "../../layouts/Base.astro";
import AdminNav from "../../components/AdminNav.astro";
import { d1, getCorte, fechaCorta, trimestreAProgramar, TRIMESTRE_ROMANO } from "../../lib/f17";
import { proveedorConfigurado } from "../../lib/mail-sender";
import { estadoProgramas } from "../../lib/seguimiento";

const env = Astro.locals.runtime.env;
const db = env.DB;
const [corte, suscriptos, ultimoAviso] = await Promise.all([
  getCorte(d1(db)),
  db.prepare("SELECT SUM(activo = 1) AS activos, COUNT(*) AS total FROM suscriptores").first<{ activos: number | null; total: number }>(),
  db.prepare("SELECT asunto, estado, creado_en FROM avisos_enviados ORDER BY id DESC LIMIT 1").first<{ asunto: string; estado: string; creado_en: string }>(),
]);
const T = corte ? trimestreAProgramar(corte) : null;
const proveedor = proveedorConfigurado(env);
const estado = corte && T ? await estadoProgramas(d1(db), corte, T, null) : [];
const cargados = estado.filter((e) => e.cargado_en).length;
const usuarios = await db
  .prepare("SELECT COUNT(*) AS total, SUM(activo = 1 AND clave_hash IS NULL) AS sin_clave FROM usuarios")
  .first<{ total: number; sin_clave: number | null }>();
---

<Base title="Panel administrativo" active="admin">
  <AdminNav active="inicio" />

  <div class="card">
    <dl class="dl-grid">
      <div>
        <dt>Datos de RAFAM al</dt>
        <dd>
          {corte ? fechaCorta(corte.hasta) : "Sin datos"}
          <small>{corte ? `${corte.mesesCargados.length} mes(es) de ${corte.anio} cargados` : "Cargá un reporte en «Datos de RAFAM»"}</small>
        </dd>
      </div>
      <div>
        <dt>Último trimestre que se puede cargar</dt>
        <dd>
          {corte && T ? `${TRIMESTRE_ROMANO[T - 1]} trimestre ${corte.anio}` : "—"}
          <small>Los anteriores ya están cerrados en RAFAM</small>
        </dd>
      </div>
      <div>
        <dt>Cargas del F17</dt>
        <dd>
          {estado.length ? `${cargados} de ${estado.length}` : "—"}
          <small>programas marcados como cargados en RAFAM ({T ? `${TRIMESTRE_ROMANO[T - 1]} trim.` : "—"})</small>
        </dd>
      </div>
      <div>
        <dt>Suscriptos activos</dt>
        <dd>
          {suscriptos?.activos ?? 0}
          <small>{suscriptos?.total ?? 0} inscripciones en total</small>
        </dd>
      </div>
      <div>
        <dt>Envío de mails</dt>
        <dd>
          {proveedor ?? "Sin configurar"}
          <small>{ultimoAviso ? `Último aviso: «${ultimoAviso.asunto}» (${ultimoAviso.estado})` : "Todavía no se mandaron avisos"}</small>
        </dd>
      </div>
    </dl>
  </div>

  <div class="service-grid" style="margin-bottom:24px;">
    <a class="service-card" href="/admin/seguimiento">
      <div class="service-card-top"><span class="service-number">01</span><span class="service-arrow" aria-hidden="true">↗</span></div>
      <span class="eyebrow">Formulario 17</span>
      <h3 style="font-size:28px;">Seguimiento</h3>
      <p>Qué secretarías descargaron el F17 de cada programa y cuáles ya lo cargaron en RAFAM.</p>
      <span class="service-cta">Ingresar <span aria-hidden="true">→</span></span>
    </a>
    <a class="service-card" href="/admin/usuarios">
      <div class="service-card-top"><span class="service-number">02</span><span class="service-arrow" aria-hidden="true">↗</span></div>
      <span class="eyebrow">Accesos</span>
      <h3 style="font-size:28px;">Usuarios</h3>
      <p>{usuarios?.total ?? 0} usuarios{usuarios?.sin_clave ? ` · ${usuarios.sin_clave} sin contraseña` : ""}. Crear, generar contraseñas y asignar jurisdicciones.</p>
      <span class="service-cta">Ingresar <span aria-hidden="true">→</span></span>
    </a>
    <a class="service-card" href="/admin/datos">
      <div class="service-card-top"><span class="service-number">03</span><span class="service-arrow" aria-hidden="true">↗</span></div>
      <span class="eyebrow">Formulario 17</span>
      <h3 style="font-size:28px;">Datos de RAFAM</h3>
      <p>Qué meses están cargados y subir a mano un reporte de ejecución de gastos de RAFAM.</p>
      <span class="service-cta">Ingresar <span aria-hidden="true">→</span></span>
    </a>
  </div>
  <div class="service-grid">
    <a class="service-card" href="/admin/suscriptores">
      <div class="service-card-top"><span class="service-number">04</span><span class="service-arrow" aria-hidden="true">↗</span></div>
      <span class="eyebrow">Lista de difusión</span>
      <h3 style="font-size:28px;">Suscriptos</h3>
      <p>Ver quién está inscripto, dar de baja o reactivar y descargar la lista en CSV.</p>
      <span class="service-cta">Ingresar <span aria-hidden="true">→</span></span>
    </a>
    <a class="service-card" href="/admin/avisos">
      <div class="service-card-top"><span class="service-number">05</span><span class="service-arrow" aria-hidden="true">↗</span></div>
      <span class="eyebrow">Comunicación</span>
      <h3 style="font-size:28px;">Avisos y fechas</h3>
      <p>Publicar avisos y fechas de vencimiento en el sitio, con alertas automáticas por mail a la lista.</p>
      <span class="service-cta">Ingresar <span aria-hidden="true">→</span></span>
    </a>
  </div>
</Base>
