---
import Base from "../../layouts/Base.astro";
import AdminNav from "../../components/AdminNav.astro";
import { fechaCorta } from "../../lib/f17";
import { conCredenciales, credencialesFaltantes, ultimasCorridas } from "../../lib/sync-rafamor-sql";

const db = Astro.locals.runtime.env.DB;
const cortes = await db
  .prepare("SELECT anio, mes, desde, hasta, mes_completo, filas, archivo, origen, cargado_en FROM rafam_cortes ORDER BY anio DESC, mes DESC")
  .all<{ anio: number; mes: number; desde: string; hasta: string; mes_completo: number; filas: number; archivo: string | null; origen: string; cargado_en: string }>();
const corridas = await ultimasCorridas(db, 6);
const faltanCredenciales = credencialesFaltantes(await conCredenciales(db, Astro.locals.runtime.env)).length > 0;
const ESTADO: Record<string, string> = {
  ok: "trajo datos",
  al_dia: "ya estaba al día",
  tope: "tope diario",
  error: "error",
  corriendo: "no terminó (la cortó Cloudflare)",
};
const MESES = ["Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio", "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre"];
const q = Astro.url.searchParams;
---

<Base title="Datos de RAFAM · Panel" active="admin">
  <AdminNav active="datos" />

  {q.get("ok") && <div class="alert alert-success">{q.get("msg")}</div>}
  {q.get("error") && <div class="alert alert-error">{q.get("msg")}</div>}

  <div class="instructivo-layout">
    <div class="card">
      <div class="card-header">
        <div>
          <h2 class="card-title">Meses cargados</h2>
          <p class="card-intro">
            Por cada mes queda la foto del último reporte de RAFAM cargado. El F17 toma el crédito vigente de la foto más nueva y
            suma el compromiso de cada trimestre.
          </p>
        </div>
      </div>
      {
        cortes.results.length === 0 ? (
          <p class="empty-state">Todavía no hay datos cargados.</p>
        ) : (
          <div class="table-container">
            <table class="table">
              <thead>
                <tr>
                  <th>Mes</th>
                  <th>Período del reporte</th>
                  <th>Filas</th>
                  <th>Archivo</th>
                  <th>Cargado (UTC)</th>
                </tr>
              </thead>
              <tbody>
                {cortes.results.map((c) => (
                  <tr>
                    <td>
                      <strong>
                        {MESES[c.mes - 1]} {c.anio}
                      </strong>{" "}
                      {!c.mes_completo && <span class="badge badge-warning">parcial</span>}
                    </td>
                    <td>
                      {fechaCorta(c.desde)} al {fechaCorta(c.hasta)}
                    </td>
                    <td class="num">{c.filas.toLocaleString("es-AR")}</td>
                    <td style="font-size:12px; color:#666;">
                      {c.archivo}
                      <br />
                      <span class="badge badge-muted">
                        {c.origen === "panel" ? "subido en el panel" : c.origen === "rafamor_sql" ? "sincronizado desde RAFAMOR SQL" : "sync-rafamor.mjs (PC de RAFAMOR)"}
                      </span>
                    </td>
                    <td style="white-space:nowrap; font-size:13px;">{c.cargado_en.slice(0, 16).replace("T", " ")}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )
      }
    </div>

    <aside>
      <form class="card" id="subir-reporte">
        <span class="eyebrow">Carga manual</span>
        <h2 class="card-title" style="margin:8px 0 8px;">Subir un reporte de RAFAM</h2>
        <p class="card-intro" style="margin-bottom:16px;">
          En RAFAM: <em>Estado de Ejecución del Presupuesto de Gastos</em>, del día 1 al último día del mes (o hasta hoy si es el
          mes en curso), todas las partidas, exportado a Excel (.xls). Reemplaza la foto de ese mes.
        </p>
        <label class="form-group">Archivo
          <input class="form-control" type="file" name="archivo" accept=".xls,.xlsx" required />
        </label>
        <div id="vista-previa" class="alert alert-warning" hidden></div>
        <div class="form-actions" style="justify-content:flex-start;">
          <button class="btn btn-primary" type="submit" disabled>Cargar</button>
        </div>
      </form>
      <form class="card" method="post" action="/api/admin/rafamor-credenciales">
        <span class="eyebrow">Credenciales de RAFAMOR SQL</span>
        {
          faltanCredenciales ? (
            <p class="card-intro" style="color:#b00020;">
              <strong>Faltan.</strong> Sin ellas no se puede traer nada de RAFAMOR SQL. Pegá los dos datos del token de servicio
              (CF-Access-Client-Id y CF-Access-Client-Secret).
            </p>
          ) : (
            <p class="card-intro">Cargadas. Solo hace falta volver a pegarlas si se cambia el token de servicio.</p>
          )
        }
        <label class="form-group">Client ID
          <input class="form-control" name="client_id" required autocomplete="off" placeholder="xxxxxxxx.access" />
        </label>
        <label class="form-group">Client Secret
          <input class="form-control" name="client_secret" type="password" required autocomplete="off" placeholder="cfast_…" />
        </label>
        <div class="form-actions" style="justify-content:flex-start;">
          <button class="btn btn-primary" type="submit">Guardar</button>
        </div>
      </form>
      <div class="card" id="sync-rafamor">
        <span class="eyebrow">Carga automática</span>
        <p class="card-intro">
          Cada 30 minutos se trae solo desde RAFAMOR SQL (la base en la nube que actualiza RAFAMOR) el mes en curso o cualquier mes
          que haya quedado parcial, uno por vez. Nunca pisa un mes ya cerrado ni un reporte de RAFAM de la misma fecha.
        </p>
        {
          corridas.length > 0 && (
            <ul style="font-size:13px; margin:0 0 14px; padding-left:18px; color:#555;">
              {corridas.map((c) => (
                <li>
                  {c.inicio.slice(5, 16).replace("T", " ")} UTC · {c.origen === "panel" ? "botón" : "automática"} ·{" "}
                  <strong style={c.estado === "error" || c.estado === "corriendo" ? "color:#b00020" : ""}>{ESTADO[c.estado] ?? c.estado}</strong>
                  {c.estado === "ok" && c.mes && ` · ${MESES[c.mes - 1]} al ${fechaCorta(c.hasta ?? "")}`}
                  {c.detalle && <span style="display:block; color:#777;">{c.detalle}</span>}
                </li>
              ))}
            </ul>
          )
        }
        <div id="sync-rafamor-resultado" class="alert alert-warning" hidden></div>
        <div class="form-actions" style="justify-content:flex-start;">
          <button class="btn btn-secondary" type="button" id="sync-rafamor-boton">Sincronizar ahora</button>
        </div>
      </div>
    </aside>
  </div>
</Base>

<script>
  import { iniciarSubidaRafam, iniciarSyncRafamor } from "../../scripts/admin-datos";
  iniciarSubidaRafam();
  iniciarSyncRafamor();
</script>
