---
import Base from "../../layouts/Base.astro";
import AdminNav from "../../components/AdminNav.astro";
import { listarSuscriptores } from "../../lib/mailing";

const verTodos = Astro.url.searchParams.get("todos") === "1";
const todos = await listarSuscriptores(Astro.locals.runtime.env.DB, false);
const activos = todos.filter((s) => s.activo);
const filas = verTodos ? todos : activos;
const fecha = (s: string | null) => (s ? s.slice(0, 10).split("-").reverse().join("/") : "");
---

<Base title="Suscriptos · Panel" active="admin">
  <AdminNav active="suscriptores" />
  <div class="card">
    <div class="card-header">
      <div>
        <h2 class="card-title">Lista de difusión</h2>
        <p class="card-intro">{activos.length} suscriptos activos · {todos.length - activos.length} dados de baja</p>
      </div>
      <div class="f17-acciones">
        <a class="btn btn-secondary" href={verTodos ? "/admin/suscriptores" : "/admin/suscriptores?todos=1"}>
          {verTodos ? "Ver solo activos" : "Ver también las bajas"}
        </a>
        <a class="btn btn-secondary" href="/api/admin/suscriptores.csv?activos=1">CSV activos <span aria-hidden="true">↓</span></a>
        <a class="btn btn-primary" href="/api/admin/suscriptores.csv">CSV completo <span aria-hidden="true">↓</span></a>
      </div>
    </div>
    {
      filas.length === 0 ? (
        <p class="empty-state">Todavía no hay suscriptos.</p>
      ) : (
        <div class="table-container">
          <table class="table" style="min-width:1100px;">
            <thead>
              <tr>
                <th>Nombre</th>
                <th>Secretaría</th>
                <th>Cargo</th>
                <th>Programas / categorías</th>
                <th>Mail institucional</th>
                <th>Contacto alternativo</th>
                <th>Alta</th>
                <th>Estado</th>
              </tr>
            </thead>
            <tbody>
              {filas.map((s) => (
                <tr>
                  <td>{s.nombre}</td>
                  <td>{s.secretaria}</td>
                  <td>{s.cargo}</td>
                  <td>{s.programas}</td>
                  <td>
                    <a href={`mailto:${s.email}`}>{s.email}</a>
                  </td>
                  <td>
                    {s.email_alternativo}
                    {s.telefono && (
                      <>
                        <br />
                        {s.telefono}
                      </>
                    )}
                  </td>
                  <td>{fecha(s.creado_en)}</td>
                  <td>
                    <form method="post" action="/api/admin/suscriptores" style="display:flex; gap:8px; align-items:center;">
                      <input type="hidden" name="id" value={s.id} />
                      <input type="hidden" name="activo" value={s.activo ? "0" : "1"} />
                      <span class:list={["badge", s.activo ? "badge-success" : "badge-muted"]}>{s.activo ? "Activo" : "Baja"}</span>
                      <button class="btn btn-secondary btn-sm" type="submit">
                        {s.activo ? "Dar de baja" : "Reactivar"}
                      </button>
                    </form>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )
    }
  </div>
</Base>
