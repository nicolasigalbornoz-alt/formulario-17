---
import Base from "../../layouts/Base.astro";
import { INSTRUCTIVOS, drivePreview, driveVer, youtubeEmbed, youtubeVer } from "../../lib/instructivos";

const instructivo = INSTRUCTIVOS.find((i) => i.slug === Astro.params.slug);
if (!instructivo) return new Response("Instructivo no encontrado", { status: 404 });
const otros = INSTRUCTIVOS.filter((i) => i.slug !== instructivo.slug);
---

<Base title={instructivo.titulo} active="instructivos" description={instructivo.resumen}>
  <div class="page-heading">
    <div>
      <span class="eyebrow">Instructivos · {instructivo.grupo}</span>
      <h1>{instructivo.titulo}</h1>
      <p>{instructivo.resumen}</p>
    </div>
    <span class="page-heading-mark" aria-hidden="true">{instructivo.codigo}</span>
  </div>

  <div class="instructivo-layout">
    <div>
      <div class="card prose">
        {instructivo.texto.map((t) => <p>{t}</p>)}
      </div>
      {
        instructivo.materiales.map((m) => (
          <div class="card">
            <div class="card-header">
              <h2 class="card-title">{m.titulo}</h2>
              <a class="btn btn-secondary btn-sm" href={m.tipo === "pdf" ? driveVer(m.id) : youtubeVer(m.id)} target="_blank" rel="noreferrer">
                {m.tipo === "pdf" ? "Abrir en Drive" : "Ver en YouTube"} <span aria-hidden="true">↗</span>
              </a>
            </div>
            {m.tipo === "pdf" ? (
              <iframe class="embed-frame" src={drivePreview(m.id)} title={m.titulo} loading="lazy" allow="autoplay" />
            ) : (
              <iframe
                class="embed-video"
                src={youtubeEmbed(m.id)}
                title={m.titulo}
                loading="lazy"
                allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
              />
            )}
          </div>
        ))
      }
    </div>
    <aside class="instructivo-aside">
      {
        instructivo.enlaces && (
          <div class="card">
            <span class="eyebrow">Herramientas</span>
            {instructivo.enlaces.map((e) => (
              <p style="margin-top:12px;">
                <a class="btn btn-primary" href={e.href} style="width:100%;">
                  {e.label} <span aria-hidden="true">→</span>
                </a>
              </p>
            ))}
          </div>
        )
      }
      <div class="card">
        <span class="eyebrow">Otros instructivos</span>
        <ul style="list-style:none; margin-top:10px;">
          {
            otros.map((o) => (
              <li style="border-top:1px solid #eee; padding:10px 0;">
                <a href={`/instructivos/${o.slug}`} style="font-weight:700; text-decoration:none;">
                  {o.codigo} · {o.titulo}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="card">
        <span class="eyebrow">¿Dudas?</span>
        <p class="card-intro">
          <a href="mailto:dir.presupuesto@moron.gob.ar">dir.presupuesto@moron.gob.ar</a> · Interno 7714
        </p>
      </div>
    </aside>
  </div>
</Base>
