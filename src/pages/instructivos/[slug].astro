---
export const prerender = true;
import Base from "../../layouts/Base.astro";

export function getStaticPaths() {
  return ["introduccion", "formulacion", "informes-trimestrales", "gastos-ejecutados"].map((slug) => ({
    params: { slug },
  }));
}

const guias: Record<string, { titulo: string; desc: string }> = {
  introduccion: { titulo: "Introducción", desc: "Qué es el Formulario 17 y quiénes lo completan." },
  formulacion: { titulo: "Formulación", desc: "Cómo armar el presupuesto por programa y partida." },
  "informes-trimestrales": { titulo: "Informes trimestrales", desc: "Cómo reportar lo ejecutado cada trimestre." },
  "gastos-ejecutados": { titulo: "Gastos ejecutados", desc: "Cómo registrar y verificar los gastos ya ejecutados." },
};

const { slug } = Astro.params;
const guia = slug ? guias[slug] : undefined;
if (!guia) return Astro.redirect("/instructivos");
---

<Base title={guia.titulo} active="instructivos">
  <section class="container" style="padding: 48px 24px; max-width: 820px;">
    <a href="/instructivos" style="font-size:0.85rem;">&larr; Instructivos</a>
    <h1 style="font-size:2.2rem; margin: 14px 0 6px;">{guia.titulo}</h1>
    <p style="color:var(--color-gray-500);">{guia.desc}</p>
    <div class="card" style="margin-top:28px; border-top-color: var(--color-gray-200);">
      <p style="color:var(--color-gray-500);">
        Contenido a cargar por la Dirección de Presupuesto. Este espacio va a incluir el instructivo
        completo (texto y/o PDF descargable) para "{guia.titulo.toLowerCase()}".
      </p>
    </div>
  </section>
</Base>
