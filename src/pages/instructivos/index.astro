---
import Base from "../../layouts/Base.astro";
import { INSTRUCTIVOS, GRUPOS } from "../../lib/instructivos";
---

<Base title="Instructivos" active="instructivos">
  <div class="page-heading">
    <div>
      <span class="eyebrow">Guías paso a paso</span>
      <h1>Instructivos</h1>
      <p>
        A distintos niveles de la estructura y distintos tipos de categorías presupuestarias les corresponde cargar distintos
        formularios. Para entender por qué, empezá por la introducción al Presupuesto por Programas.
      </p>
    </div>
    <span class="page-heading-mark" aria-hidden="true">02</span>
  </div>

  {
    GRUPOS.map((grupo) => (
      <section class="instructivo-grupo">
        <span class="eyebrow">{grupo === "Presupuesto por Programas" ? "Para empezar" : grupo === "Formulación" ? "Formularios anuales" : grupo === "Trimestrales" ? "Formularios trimestrales" : "Seguimiento"}</span>
        <h2>{grupo}</h2>
        <div class="service-grid">
          {INSTRUCTIVOS.filter((i) => i.grupo === grupo).map((i) => (
            <a class="service-card" href={`/instructivos/${i.slug}`}>
              <div class="service-card-top">
                <span class="service-number">{i.codigo}</span>
                <span class="service-arrow" aria-hidden="true">↗</span>
              </div>
              <span class="eyebrow">{i.materiales.map((m) => (m.tipo === "pdf" ? "PDF" : "Video")).join(" + ")}</span>
              <h3 style="font-size:26px;">{i.titulo}</h3>
              <p>{i.resumen}</p>
              <span class="service-cta">
                Ver instructivo <span aria-hidden="true">→</span>
              </span>
            </a>
          ))}
        </div>
      </section>
    ))
  }
</Base>
