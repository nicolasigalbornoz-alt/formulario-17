---
import Base from "../layouts/Base.astro";
import F17Nav from "../components/F17Nav.astro";
import Novedades from "../components/Novedades.astro";
import {
  d1,
  getCorte,
  listJurisdicciones,
  listProgramas,
  listCategoriasJurisdiccion,
  listFuentes,
  getDatosPrograma,
  armarF17,
  fechaCorta,
  trimestresDisponibles,
  trimestreElegido,
  TRIMESTRE_ROMANO,
  NOMBRE_TRIMESTRE,
  type CodDenom,
  type CategoriaConPrograma,
  type F17Reporte,
} from "../lib/f17";
import { puedeVer } from "../lib/auth";
import { conservadasDelMes } from "../lib/sync-rafamor-sql";

const NOMBRE_MES = ["enero", "febrero", "marzo", "abril", "mayo", "junio", "julio", "agosto", "septiembre", "octubre", "noviembre", "diciembre"];

const usuario = Astro.locals.usuario!;
const sql = d1(Astro.locals.runtime.env.DB);
const params = Astro.url.searchParams;

// Dos carriles separados: por programa (lo que se carga en RAFAM) o por
// categoría programática (hay que consolidarla después con las demás
// categorías del programa).
const modo = params.get("modo") === "categoria" ? "categoria" : "programa";
let jurisdiccion = params.get("jurisdiccion") || "";
let programa = modo === "programa" ? params.get("programa") || "" : "";
const catprog = modo === "categoria" ? params.get("catprog") || "" : "";
let fuente = params.get("fuente") || "";
// El formulario se muestra recién al tocar «Ver formulario» (ver=1). Los
// cambios en los desplegables solo recargan las opciones.
const ver = params.get("ver") === "1";

const corte = await getCorte(sql);
// Trimestre que se carga: solo los que tienen cerrados los anteriores.
const disponibles = corte ? trimestresDisponibles(corte) : [];
const T = corte ? trimestreElegido(corte, params.get("trimestre")) : null;
const conservadas = corte ? await conservadasDelMes(Astro.locals.runtime.env.DB, corte.anio, corte.mes) : null;

let jurisdicciones: CodDenom[] = [];
let programas: CodDenom[] = [];
let categorias: CategoriaConPrograma[] = [];
let fuentes: CodDenom[] = [];
let reporte: F17Reporte | null = null;
let otrasCategorias: CodDenom[] = [];
let sinPermiso = false;

if (corte) {
  jurisdicciones = (await listJurisdicciones(sql, corte)).filter((j) => puedeVer(usuario, j.cod));
  if (jurisdiccion && !puedeVer(usuario, jurisdiccion)) {
    sinPermiso = true;
    jurisdiccion = "";
  }
  // Una secretaría con una sola jurisdicción no tiene que elegirla.
  if (!jurisdiccion && jurisdicciones.length === 1) jurisdiccion = jurisdicciones[0].cod;

  if (jurisdiccion) {
    if (modo === "programa") programas = await listProgramas(sql, corte, jurisdiccion);
    else categorias = await listCategoriasJurisdiccion(sql, corte, jurisdiccion);
  }
  if (modo === "categoria" && catprog) programa = categorias.find((c) => c.cod === catprog)?.programa.cod ?? "";
  if (jurisdiccion && programa) {
    fuentes = await listFuentes(sql, corte, jurisdiccion, programa, modo === "categoria" ? catprog : null);
    // Casi todos los programas tienen una sola fuente: se preselecciona.
    if (!fuente && fuentes.length === 1) fuente = fuentes[0].cod;
    if (fuente && !fuentes.some((f) => f.cod === fuente)) fuente = "";
  }
  if (ver && jurisdiccion && programa && fuente) {
    const datos = await getDatosPrograma(sql, corte, jurisdiccion, programa);
    reporte = datos ? armarF17({ ...datos, trimestre: T! }, fuente, modo === "categoria" ? catprog : null) : null;
    if (datos && modo === "categoria") otrasCategorias = datos.categorias.filter((c) => c.cod !== catprog);
  }
}

const pad2 = (n: number) => String(n).padStart(2, "0");
const fmt = (n: number | null) =>
  n === null ? "" : n.toLocaleString("es-AR", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
const categoriasPorPrograma = [...new Set(categorias.map((c) => c.programa.cod))].map((p) => ({
  programa: categorias.find((c) => c.programa.cod === p)!.programa,
  categorias: categorias.filter((c) => c.programa.cod === p),
}));
const alDia = corte ? fechaCorta(corte.hasta).slice(0, 5) : "";
const urlPorPrograma =
  "/formulario-17?" +
  new URLSearchParams({ modo: "programa", trimestre: String(T ?? ""), jurisdiccion, programa, fuente, ver: "1" });
---

<Base title="Formulario 17" active="f17" description="Formulario 17 prellenado: programación financiera del compromiso por programa o categoría programática.">
  <F17Nav
    active="prellenado"
    texto="Elegí el trimestre y si lo sacás por programa o por categoría programática para ver el F17 prellenado: las partidas con crédito vigente, el compromiso del año anterior y el de los trimestres ya ejecutados. Descargalo en Excel y completá ahí los trimestres a programar."
  />

  <Novedades variante="compacto" />

  {sinPermiso && <div class="alert alert-error">Tu usuario no tiene acceso a esa jurisdicción.</div>}
  {
    !corte && (
      <div class="alert alert-warning">
        Todavía no hay datos de ejecución cargados. La Subsecretaría los actualiza desde RAFAM; volvé a intentar más tarde.
      </div>
    )
  }
  {corte && jurisdicciones.length === 0 && <div class="alert alert-warning">Tu usuario todavía no tiene jurisdicciones asignadas. Pedíselo a la Subsecretaría.</div>}

  {
    corte && jurisdicciones.length > 0 && (
      <form method="get" id="filtros" class="card no-print">
        <div class="card-header">
          <div>
            <h2 class="card-title">Elegí el formulario</h2>
            <p class="card-intro">
              Datos de RAFAM al <strong>{fechaCorta(corte.hasta)}</strong>. Solo se pueden cargar trimestres con los anteriores
              cerrados: hoy, hasta el <strong>{TRIMESTRE_ROMANO[disponibles.at(-1)! - 1]}</strong> de {corte.anio}.
            </p>
          </div>
          <fieldset class="modo-switch">
            <legend class="sr-only">Sacar el F17 por</legend>
            <label>
              <input type="radio" name="modo" value="programa" checked={modo === "programa"} />
              <span>Por programa</span>
            </label>
            <label>
              <input type="radio" name="modo" value="categoria" checked={modo === "categoria"} />
              <span>Por categoría programática</span>
            </label>
          </fieldset>
        </div>

        {
          modo === "categoria" && (
            <div class="alert alert-warning aviso-consolidar" role="alert">
              <strong>Advertencia: el Formulario 17 se carga en RAFAM por programa.</strong> Si lo sacás por categoría programática,
              antes de cargarlo tenés que consolidarlo con las demás categorías del mismo programa{otrasCategorias.length > 0 ? ` (${otrasCategorias.map((c) => c.cod).join(", ")})` : ""}: completá el Excel de cada categoría y unificalos en <a href="/formulario-17/unificar">Unificar categorías</a>{programa && ver ? <>, o <a href={urlPorPrograma}>sacalo directamente por programa</a></> : null}.
            </div>
          )
        }

        <div class="search-bar">
          <label class="filter-field" style="flex-grow:0; min-width:190px;">
            <span>Trimestre a cargar</span>
            <select class="form-control" name="trimestre" id="trimestre">
              {disponibles.map((t) => (
                <option value={t} selected={t === T}>
                  {TRIMESTRE_ROMANO[t - 1]} · {NOMBRE_TRIMESTRE[t - 1]}
                </option>
              ))}
            </select>
          </label>
          <label class="filter-field">
            <span>Jurisdicción</span>
            <select class="form-control" name="jurisdiccion" id="jurisdiccion" required>
              {jurisdicciones.length > 1 && <option value="">Elegir…</option>}
              {jurisdicciones.map((j) => (
                <option value={j.cod} selected={j.cod === jurisdiccion}>
                  {j.cod} - {j.denom}
                </option>
              ))}
            </select>
          </label>
          {modo === "programa" ? (
            <label class="filter-field">
              <span>Programa</span>
              <select class="form-control" name="programa" id="programa" required disabled={!jurisdiccion}>
                <option value="">Elegir…</option>
                {programas.map((p) => (
                  <option value={p.cod} selected={p.cod === programa}>
                    {p.cod} - {p.denom}
                  </option>
                ))}
              </select>
            </label>
          ) : (
            <label class="filter-field" style="flex-grow:2;">
              <span>Categoría programática</span>
              <select class="form-control" name="catprog" id="catprog" required disabled={!jurisdiccion}>
                <option value="">Elegir…</option>
                {categoriasPorPrograma.map((g) => (
                  <optgroup label={`Programa ${g.programa.cod} · ${g.programa.denom}`}>
                    {g.categorias.map((c) => (
                      <option value={c.cod} selected={c.cod === catprog}>
                        {c.cod} - {c.denom}
                      </option>
                    ))}
                  </optgroup>
                ))}
              </select>
            </label>
          )}
          <label class="filter-field">
            <span>Fuente de financiamiento</span>
            <select class="form-control" name="fuente" id="fuente" required disabled={!programa}>
              <option value="">Elegir…</option>
              {fuentes.map((f) => (
                <option value={f.cod} selected={f.cod === fuente}>
                  {f.cod} - {f.denom}
                </option>
              ))}
            </select>
          </label>
          <div class="search-actions">
            <button class="btn btn-primary" type="submit" name="ver" value="1">
              Ver formulario <span aria-hidden="true">→</span>
            </button>
          </div>
        </div>
      </form>
    )
  }

  {
    corte && ver && jurisdiccion && programa && fuente && !reporte && (
      <div class="alert alert-warning">No hay partidas con crédito vigente ni compromiso para esa combinación.</div>
    )
  }

  {
    conservadas && jurisdiccion && conservadas.jurisdicciones.includes(jurisdiccion) && (
      <div class="alert alert-warning" role="alert">
        <strong>Atención:</strong> para esta jurisdicción, {NOMBRE_MES[corte!.mes - 1]} tiene datos al {fechaCorta(conservadas.hasta)} (no al{" "}
        {fechaCorta(corte!.hasta)}). RAFAMOR SQL todavía suma sus programas sin actividades a otra categoría, así que se mantuvo el
        último reporte de RAFAM. Se completa solo cuando RAFAMOR SQL lo corrija, o subiendo en el panel el reporte de RAFAM del mes completo.
      </div>
    )
  }

  {
    reporte && (
      <section class="card f17-resumen" id="f17" data-reporte={JSON.stringify(reporte)} data-modo={modo} data-otras={otrasCategorias.map((c) => c.cod).join(",")}>
        <div class="card-header">
          <div class="f17-titulo">
            <span class="eyebrow">
              {modo === "categoria" ? "Por categoría programática" : "Por programa"} · Jurisdicción {reporte.jurisdiccion.cod} ·{" "}
              {reporte.jurisdiccion.denom}
            </span>
            <h2>
              {reporte.catprog
                ? `${reporte.catprog.cod} · ${reporte.catprog.denom}`
                : `Programa ${reporte.programa.cod} · ${reporte.programa.denom}`}
            </h2>
            <p>
              {reporte.catprog ? `Programa ${reporte.programa.cod} · ${reporte.programa.denom} · ` : "Total del programa (todas sus categorías) · "}
              Fuente {reporte.fuente.cod} - {reporte.fuente.denom}
            </p>
          </div>
          <div class="f17-acciones no-print">
            <button class="btn btn-primary" type="button" id="descargar">
              Descargar Excel <span aria-hidden="true">↓</span>
            </button>
            <button class="btn btn-secondary" type="button" onclick="window.print()">
              Imprimir
            </button>
          </div>
        </div>

        <dl class="f17-meta">
          <div>
            <dt>Trimestre que se carga</dt>
            <dd>{pad2(reporte.trimestre)} · {TRIMESTRE_ROMANO[reporte.trimestre - 1]} trimestre {reporte.anio} ({NOMBRE_TRIMESTRE[reporte.trimestre - 1]})</dd>
          </div>
          <div>
            <dt>Datos de RAFAM al</dt>
            <dd>{fechaCorta(reporte.corte.hasta)}</dd>
          </div>
          <div>
            <dt>Crédito vigente total</dt>
            <dd>$ {fmt(reporte.totales.creditoVigente)}</dd>
          </div>
          <div>
            <dt>Disponible total al {alDia}</dt>
            <dd>$ {fmt(reporte.totales.disponible)}</dd>
          </div>
        </dl>

        <div class="f17-leyenda">
          <span><i style="background:var(--f17-ejecutado)"></i>Trimestre ejecutado</span>
          <span><i style="background:var(--f17-programar)"></i>Trimestre a programar (se completa en el Excel)</span>
          <span><i style="background:var(--f17-excedida)"></i>Crédito disponible negativo: la partida no se carga en el F17</span>
        </div>

        <div class="table-container">
          <table class="table f17-table">
            <thead>
              <tr>
                <th class="t-oscuro">Fte.</th>
                <th class="t-oscuro">Partida</th>
                <th class="t-oscuro" style="text-align:left">Denominación</th>
                <th class="t-oscuro">Compromiso del año anterior</th>
                <th class="t-oscuro">Igual trimestre año anterior</th>
                <th class="t-oscuro">Crédito vigente</th>
                {[1, 2, 3, 4].map((t) => (
                  <th class={t >= reporte.trimestre ? "t-programar" : "t-ejecutado"}>Trimestre {TRIMESTRE_ROMANO[t - 1]}</th>
                ))}
                <th class="t-oscuro" title="Crédito disponible de RAFAM: vigente menos preventivo y compromiso acumulados del año">
                  Disponible al {alDia}
                </th>
                <th class="t-oscuro">Total anual</th>
              </tr>
            </thead>
            <tbody>
              {reporte.filas.map((f) => (
                <tr class:list={{ excedida: f.excedida }}>
                  <td class="num">{f.fuenteCod}</td>
                  <td class="partida">{f.partidaCod}</td>
                  <td class="denominacion">{f.partidaDenom}</td>
                  <td class="num">{fmt(f.compromisoAnioAnterior)}</td>
                  <td class="num">{fmt(f.igualTrimestreAnioAnterior)}</td>
                  <td class="num">{fmt(f.creditoVigente)}</td>
                  {f.trimestres.map((v) => (v === null ? <td class="a-programar" /> : <td class="num">{fmt(v)}</td>))}
                  <td class="num">{fmt(f.disponible)}</td>
                  <td class="num">{fmt(f.totalAnual)}</td>
                </tr>
              ))}
            </tbody>
            <tfoot>
              <tr>
                <td colspan="3">Total</td>
                <td class="num">{fmt(reporte.totales.compromisoAnioAnterior)}</td>
                <td class="num">{fmt(reporte.totales.igualTrimestreAnioAnterior)}</td>
                <td class="num">{fmt(reporte.totales.creditoVigente)}</td>
                {reporte.totales.trimestres.map((v) => (v === null ? <td class="a-programar" /> : <td class="num">{fmt(v)}</td>))}
                <td class="num">{fmt(reporte.totales.disponible)}</td>
                <td class="num">{fmt(reporte.totales.totalAnual)}</td>
              </tr>
            </tfoot>
          </table>
        </div>

        <div class="f17-notas">
          <ul>
            <li>
              <strong>La página no guarda nada de lo que programes.</strong> Descargá el Excel, completá ahí los trimestres a
              programar según el <a href="/instructivos/f17">instructivo</a> y después hacé la carga en RAFAM. Cuando termines,
              marcalo en <a href="/formulario-17/avance">Avance de carga</a>.
            </li>
            <li>
              El crédito vigente y el disponible son los del {fechaCorta(reporte.corte.hasta)}, último día con información de RAFAM.
              El disponible se calcula como RAFAM: vigente menos preventivo y compromiso acumulados del año. Las partidas con
              disponible negativo salen en rojo y no se cargan en el Formulario 17.
            </li>
            <li>
              Los trimestres ejecutados son los ya cerrados, anteriores al que se carga: el F17 se anticipa a la ejecución, así que
              no muestra lo que se va comprometiendo en el trimestre que se programa.
            </li>
            <li>Si el programa tiene crédito en más de una fuente de financiamiento hay un formulario por fuente.</li>
          </ul>
        </div>
      </section>
    )
  }
</Base>

<script>
  import { iniciarFiltros, iniciarDescargas } from "../scripts/f17-page";
  iniciarFiltros();
  iniciarDescargas();
</script>
