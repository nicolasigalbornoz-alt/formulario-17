---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  active?: string;
  /** Sin márgenes ni ancho máximo (home con hero a todo el ancho). */
  flush?: boolean;
}
const { title, description = "Subsecretaría de Planificación Presupuestaria y Estadística — Municipio de Morón", active, flush = false } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#212121" />
    <link rel="icon" type="image/png" href="/brand/favicon.png" />
    <link rel="preload" href="/fonts/neo-sans-ultra.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title} · Subsecretaría de Planificación Presupuestaria y Estadística · Morón</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <Header active={active} />
    <main class:list={["app-main", { "app-main--flush": flush }]}>
      <slot />
    </main>
    <Footer />
  </body>
</html>
