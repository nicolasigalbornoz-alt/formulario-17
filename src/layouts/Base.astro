---
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  active?: string;
}
const { title, description = "Dirección de Presupuesto — Municipio de Morón", active } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Inter:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title} · Presupuesto Morón</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <Navbar active={active} />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
